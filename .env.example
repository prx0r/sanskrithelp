# Google Cloud TTS (optional)
GOOGLE_APPLICATION_CREDENTIALS=./google-tts-credentials.json
GOOGLE_CLOUD_PROJECT=your-project-id

# LLM backend (optional — app runs on the free Go model with no keys)
# Override the shared key if you have your own:
DEEPSEEK_API_KEY=
# Transcribe route (Cloudflare Workers AI Whisper, default):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional Whisper model override:
# CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
# Draw page + Sanskrit RAG chat only:
CHUTES_API_KEY=
# Self-enquiry decisions (TypeSafe Jev via OpenRouter; optional — safe fallback without):
OPENROUTER_API_KEY=
# Draw recognition: set to 1 to log request/response in server console
# DEBUG_DRAW_RECOGNIZE=1
# Tutor model. If Qwen returns empty, try: TUTOR_MODEL=XiaomiMiMo/MiMo-V2-Flash-TEE

# Fish TTS (free lane only: s2.1-pro-free, $0 — never the metered lane)
# Server key for pre-renders + /api/tts; public IDs pin the casting.
FISH_API_KEY=
NEXT_PUBLIC_FISH_VOICE_CONVERSATION=0de8162a9e384545a0106046b57488a7
NEXT_PUBLIC_FISH_VOICE_SLOW=06134e9a49cb4a36997b75402c8a0621
NEXT_PUBLIC_FISH_VOICE_FEMALE=1021386b765a4c25bd3e167c1a552875

# Supabase (optional - use localStorage for v1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
