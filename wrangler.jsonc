{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanskrithelp",
  "main": "./src/index.js",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp", "/mcp/*"]
  },
  "observability": {
    "enabled": true
  }
}
